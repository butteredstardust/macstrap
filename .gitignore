# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Local, machine-specific overrides — never commit these
*.local
local/
dotfiles/git/gitconfig
secrets/

# Credentials. Nothing here matches a file that exists today — that is the
# point. These are the names a secret arrives under when someone (or some tool)
# drops one in the repo root by accident, and `git add .` does not ask twice.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
id_rsa
id_ecdsa
id_ed25519
.netrc
.npmrc
.pypirc
credentials
credentials.*
*_credentials
*.credentials
!*.key.example
!.env.example

# Editors
.idea/
*.swp

# Tooling artefacts. These are the sneaky ones: language servers and agent
# tooling drop logs here that embed the absolute /Users/<name>/ path.
*.log
.DS_Store
Brewfile.lock.json

# Claude Code per-project local settings
**/.claude/settings.local.json
