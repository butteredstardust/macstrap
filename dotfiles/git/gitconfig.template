# ~/.gitconfig — template.
#
# WARNING: use GitHub's noreply address, not a real mailbox. Every commit you
# push publishes the address you set here. Find yours at
# https://github.com/settings/emails. The form is
#   <id>+<username>@users.noreply.github.com
#
# scripts/dotfiles.sh copies this file to ~/.gitconfig and fills in the
# identity. It is never symlinked, because this repo is public.

[user]
	name = __GIT_NAME__
	email = __GIT_EMAIL__

[init]
	defaultBranch = main

[core]
	editor = code --wait
	excludesfile = ~/.config/git/ignore
	# Delta renders syntax-highlighted diffs, side by side on request.
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true      # n / N to jump between files in the pager
	line-numbers = true
	dark = true

[merge]
	conflictstyle = zdiff3   # show the common ancestor; much easier to resolve

[diff]
	algorithm = histogram
	colorMoved = default

[push]
	autoSetupRemote = true   # `git push` works on a new branch
	followTags = true

[pull]
	ff = only                # never create an unexpected merge commit on pull

[fetch]
	prune = true             # remove local refs for branches deleted on the remote

[rebase]
	autosquash = true
	autostash = true

[rerere]
	enabled = true           # remember conflict resolutions, then replay them

[branch]
	sort = -committerdate    # list the most recent first in `git branch`

[column]
	ui = auto

[alias]
	s = status --short --branch
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat
	unstage = restore --staged
	amend = commit --amend --no-edit

[include]
	# Optional overrides for this machine or this employer: a different signing
	# key, a work email for one directory of repos. Git does not track it.
	path = ~/.gitconfig.local
