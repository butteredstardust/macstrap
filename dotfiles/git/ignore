# ~/.config/git/ignore — global ignores.
#
# List only what is never worth committing in ANY repo. Put project-specific
# patterns in that project's .gitignore. A global rule that hides a file from
# collaborators who do not share it causes confusion.

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
*.swp
*~

# Tooling local state
.env.local
.direnv/

# Claude Code writes per-machine permissions here. The file is local by design.
**/.claude/settings.local.json
