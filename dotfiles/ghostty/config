# Ghostty — ~/.config/ghostty/config
#
# WARNING: Ghostty reads everything after `=` to the end of the line as the
# value. A trailing `# comment` makes the value invalid. Put each comment on its
# own line above the setting.
#
# WARNING: Ghostty applies the LAST occurrence of a key. Declaring a setting
# twice discards the first one silently. Each key appears once below. Keep it
# that way.
#
# Managed by macstrap.
#
# Reload without restarting: ⌘, opens this file, ⇧⌘, reloads it.
# List every default and its docs: ghostty +show-config --default --docs

# --- Theme ----------------------------------------------------------------
theme = Gruvbox Dark
# Ghostty ships hundreds. List them with: ghostty +list-themes
# For an automatic light/dark switch: theme = light:GruvboxLight,dark:GruvboxDark

# Raise low-contrast colour pairs until they are legible. 1.0 disables this.
minimum-contrast = 1.3

# --- Font -----------------------------------------------------------------
# The Nerd Font variant is required for the glyphs in starship and eza --icons.
# Brewfile.apps installs it as font-jetbrains-mono-nerd-font.
font-family = JetBrainsMono Nerd Font
font-size = 14
# macOS only. Compensates for thin stem rendering.
font-thicken = true

# --- Window ---------------------------------------------------------------
window-height = 36
window-width = 160
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.96
background-blur = 10
unfocused-split-opacity = 0.6

# --- macOS ----------------------------------------------------------------
macos-titlebar-style = tabs
# Left ⌥ sends Esc+ for readline. Right ⌥ still types é/ø.
macos-option-as-alt = left

# --- Cursor & mouse -------------------------------------------------------
cursor-style = bar
mouse-hide-while-typing = true

# --- Keybindings ----------------------------------------------------------
# Shift+Enter inserts a newline instead of submitting. Required by REPLs and
# CLI agents that treat a bare Enter as "send".
keybind = shift+enter=text:\n
