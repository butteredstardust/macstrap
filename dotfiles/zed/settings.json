// Zed — ~/.config/zed/settings.json
//
// Kept minimal. Zed's defaults are good; this only sets the things that are
// genuinely personal. Run `zed: Open Default Settings` to see the rest.
{
  // VSCode keymap so muscle memory carries over between the two editors.
  "base_keymap": "VSCode",

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",

  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "VSCode Dark Plus"
  },

  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,

  // Zed autosaves aggressively by default; on focus change matches VS Code.
  "autosave": "on_focus_change"
}
