# ~/.zshenv — sourced by EVERY zsh, including non-interactive ones.
#
# Managed by macstrap. Keep this file tiny and side-effect free: it runs for
# every script, every editor subshell, every `ssh host command`. Anything slow
# or interactive belongs in ~/.zshrc.
#
# The one thing that legitimately lives here is environment a *non-interactive*
# tool needs. Build tooling shells out with `zsh -c`, which skips .zshrc
# entirely — a variable exported only there is invisible to it.

# Rust toolchain, needed by editors and build scripts that never see .zshrc.
#
# rustup comes from Homebrew, and Homebrew keeps it keg-only because it
# conflicts with the `rust` formula — so `cargo`, `rustc` and friends are never
# symlinked into bin/ and exist only here. `rustup` alone is symlinked into
# bin/, which is worse than it sounds: without this line a non-interactive
# shell finds `rustup` but not `cargo`, and the failure looks like a broken
# toolchain rather than a missing PATH entry.
#
# Deliberately NOT `. "$HOME/.cargo/env"`. That file is written by the upstream
# rustup.rs installer and prepends ~/.cargo/bin, whose shims are a second,
# independently-versioned copy of rustup. Both dispatch to the same toolchains
# in ~/.rustup, so the split is invisible until the two versions disagree.
# One installer owns rustup here, and it is Homebrew. See docs/05-languages.md.
#
# Hardcoded rather than `$(brew --prefix rustup)`: shelling out to brew costs
# ~100ms, and this file runs for every zsh, including every `zsh -c` a build
# script spawns. Rebuild the order rather than using an append-if-missing guard:
# a parent process may already have supplied the same entries in the wrong order.
_macstrap_rustup_dir=""
if [ -d /opt/homebrew/opt/rustup/bin ]; then
  _macstrap_rustup_dir=/opt/homebrew/opt/rustup/bin
elif [ -d /usr/local/opt/rustup/bin ]; then
  _macstrap_rustup_dir=/usr/local/opt/rustup/bin
fi

# ~/.cargo/bin is still where `cargo install` writes, so it has to stay
# reachable — but after Homebrew's rustup directory. Remove every occurrence
# of both entries first, preserving everything else inherited from the caller.
if [ -n "$_macstrap_rustup_dir" ] || [ -d "$HOME/.cargo/bin" ]; then
  typeset -a _macstrap_path _macstrap_clean_path
  _macstrap_path=("${(@s/:/)PATH}")
  _macstrap_clean_path=()
  for _macstrap_path_entry in "${_macstrap_path[@]}"; do
    case "$_macstrap_path_entry" in
      /opt/homebrew/opt/rustup/bin|/usr/local/opt/rustup/bin|"$HOME/.cargo/bin") ;;
      *) _macstrap_clean_path+=("$_macstrap_path_entry") ;;
    esac
  done
  [ -n "$_macstrap_rustup_dir" ] && _macstrap_clean_path=("$_macstrap_rustup_dir" "${_macstrap_clean_path[@]}")
  [ -d "$HOME/.cargo/bin" ] && _macstrap_clean_path+=("$HOME/.cargo/bin")
  export PATH="${(j/:/)_macstrap_clean_path}"
fi
unset _macstrap_rustup_dir _macstrap_path _macstrap_clean_path _macstrap_path_entry

# Machine-local secrets and signing keys. Read from a file rather than pasted,
# so the value lives in exactly one place and never reaches this repo.
#
# Example ~/.zshenv.local:
#   if [ -r "$HOME/.keys/updater.key" ]; then
#     export SIGNING_PRIVATE_KEY="$(cat "$HOME/.keys/updater.key")"
#     export SIGNING_PRIVATE_KEY_PASSWORD=""   # empty on purpose: an unset var
#   fi                                         # makes the CLI stop at a prompt
[ -r "$HOME/.zshenv.local" ] && . "$HOME/.zshenv.local"
