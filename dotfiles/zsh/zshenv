# ~/.zshenv — sourced by EVERY zsh, including non-interactive ones.
#
# WARNING: this file runs for every script, every editor subshell and every
# `ssh host command`. Keep it small and free of side effects. Put anything slow
# or interactive in ~/.zshrc.
#
# Managed by macstrap. Only one thing belongs here: environment a
# non-interactive tool needs. Build tooling shells out with `zsh -c`, which
# skips .zshrc. A variable exported only there is invisible to it.

# Rust toolchain, needed by editors and build scripts that never see .zshrc.
#
# Homebrew owns rustup, and keeps it keg-only because it conflicts with the
# `rust` formula. So `cargo` and `rustc` are never symlinked into bin/ and live
# only in this directory. `rustup` alone is symlinked. Without this block a
# non-interactive shell finds `rustup` but not `cargo`, and the failure reads as
# a broken toolchain rather than a missing PATH entry.
#
# Do NOT source "$HOME/.cargo/env" instead. The upstream rustup.rs installer
# writes that file, and it prepends ~/.cargo/bin. Those shims are a second,
# independently versioned copy of rustup. Both dispatch to the same toolchains
# in ~/.rustup, so the split stays invisible until the versions disagree. One
# installer owns rustup here. See docs/05-languages.md.
#
# Hardcode the prefix rather than call `$(brew --prefix rustup)`. Shelling out
# to brew costs ~100ms, and this file runs for every zsh.
#
# Rebuild the PATH order rather than append if missing. A parent process may
# already have supplied the same entries in the wrong order.
_macstrap_rustup_dir=""
if [ -d /opt/homebrew/opt/rustup/bin ]; then
  _macstrap_rustup_dir=/opt/homebrew/opt/rustup/bin
elif [ -d /usr/local/opt/rustup/bin ]; then
  _macstrap_rustup_dir=/usr/local/opt/rustup/bin
fi

# `cargo install` still writes to ~/.cargo/bin, so keep it reachable. Place it
# after Homebrew's rustup directory. Remove every occurrence of both entries
# first, and preserve everything else inherited from the caller.
if [ -n "$_macstrap_rustup_dir" ] || [ -d "$HOME/.cargo/bin" ]; then
  typeset -a _macstrap_path _macstrap_clean_path
  _macstrap_path=("${(@s/:/)PATH}")
  _macstrap_clean_path=()
  for _macstrap_path_entry in "${_macstrap_path[@]}"; do
    case "$_macstrap_path_entry" in
      /opt/homebrew/opt/rustup/bin|/usr/local/opt/rustup/bin|"$HOME/.cargo/bin") ;;
      *) _macstrap_clean_path+=("$_macstrap_path_entry") ;;
    esac
  done
  [ -n "$_macstrap_rustup_dir" ] && _macstrap_clean_path=("$_macstrap_rustup_dir" "${_macstrap_clean_path[@]}")
  [ -d "$HOME/.cargo/bin" ] && _macstrap_clean_path+=("$HOME/.cargo/bin")
  export PATH="${(j/:/)_macstrap_clean_path}"
fi
unset _macstrap_rustup_dir _macstrap_path _macstrap_clean_path _macstrap_path_entry

# Machine-local secrets and signing keys. Read each value from a file rather
# than paste it, so it lives in one place and never reaches this repo.
#
# Example ~/.zshenv.local:
#   if [ -r "$HOME/.keys/updater.key" ]; then
#     export SIGNING_PRIVATE_KEY="$(cat "$HOME/.keys/updater.key")"
#     export SIGNING_PRIVATE_KEY_PASSWORD=""   # empty on purpose: an unset var
#   fi                                         # makes the CLI stop at a prompt
[ -r "$HOME/.zshenv.local" ] && . "$HOME/.zshenv.local"
